# Cloudflare Pages _redirects

# Fix canonical redirect: Google crawled /terms-of-service but route is /terms
/terms-of-service /terms 301

# Fix broken resume URL: Google crawled /resume.pdf but actual file is /devkantkumar-resume.pdf
/resume.pdf /devkantkumar-resume.pdf 301

# Security: redirect /admin paths to /404 (actual panel is elsewhere)
/admin /404 302
/admin/* /404 302

# SPA fallback: serve index.html for any unmatched path so React Router
# can handle client-side routes on a direct load / hard refresh.
# MUST stay last — Cloudflare serves real static assets before this rule.
/* /index.html 200
