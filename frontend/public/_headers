# Cloudflare Pages _headers file
# Fixes sitemap.xml not rendering the XSL stylesheet on live
# Root cause: Cloudflare strips <?xml-stylesheet?> PI without proper Content-Type
# Fix: Explicit Content-Type headers prevent Cloudflare from transforming XML files

/sitemap.xml
  Content-Type: text/xml; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

/sitemap-blog.xml
  Content-Type: text/xml; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

/sitemap-marketplace.xml
  Content-Type: text/xml; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

/sitemap.xsl
  Content-Type: text/xsl; charset=utf-8
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

# Never cache the service worker or app shell.
# Without this Cloudflare/browser can serve a stale sw.js, so vite-plugin-pwa's
# autoUpdate never fires and users keep running an old JS bundle (old routes 404,
# old code hits blocked http:// endpoints). Always revalidate these.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Security headers for all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
